# --- twscrape (primary source, free; cookie-based) ------------------------
# Path to a JSON file with your X account cookies (see README "Cookie setup")
TW_COOKIES=./cookies.json

# --- X API v2 (fallback: `scout run --source xapi`) ------------------------
# PAY-PER-USE since Feb 2026: ~$0.005/tweet read, ~$0.010/profile read.
# The spend cap is a HARD stop enforced across all runs (ledger in scout.db).
# Default 20.0 leaves buffer under a $25 budget.
X_BEARER_TOKEN=
XAPI_SPEND_CAP_USD=20.0

# --- GitHub discovery (optional; raises rate limits from ~10 to 30 req/min) --
# Free personal access token, no scopes needed: github.com/settings/tokens
GITHUB_TOKEN=

# --- Claude classification (optional — omit to run heuristics-only) --------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Daily spend envelope (what makes an unattended daily scan safe) --------
# Total the system may spend per UTC day across Claude + X API, enforced at
# the spend sites (classify, verify, research, memo). Cheap work (heuristics,
# caches, free scraping) always runs; paid calls stop when the envelope is
# spent and resume tomorrow. 0 disables the cap.
DAILY_SPEND_CAP_USD=1.0
# Tracked-company refresh (`scout refresh`): companies re-researched per day,
# and how long before a company is due again.
SCAN_REFRESH_PER_DAY=3
REFRESH_MIN_AGE_DAYS=7

# --- Phone digest (`scout publish --push`) ---------------------------------
# A PUBLIC repo that serves the rendered digest via GitHub Pages. Separate
# from the code repo on purpose: only the rendered page goes public.
DIGEST_REPO=

# --- Grounded classification (defaults shown; all optional) -------------------
# WEBSITE_TTL_DAYS=7          # company-site text cache TTL (failures: 1 day)
# WEB_FETCH_CONCURRENCY=12    # parallel company-site fetches
# WEB_FETCH_TIMEOUT_S=8.0     # per-site fetch cap
# WEB_TEXT_MAX_CHARS=6000     # site text sent to Claude (~1.5k tokens)
# VERIFY_TOP_N=25             # adversarial verdict audit on the top N (0 = off)
# CLASSIFY_BATCH_SIZE=5       # accounts per Claude classification call
