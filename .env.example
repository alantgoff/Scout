# --- twscrape (primary source, free; cookie-based) ------------------------
# Path to a JSON file with your X account cookies (see README "Cookie setup")
TW_COOKIES=./cookies.json

# --- X API v2 (fallback: `scout run --source xapi`) ------------------------
# PAY-PER-USE since Feb 2026: ~$0.005/tweet read, ~$0.010/profile read.
# The spend cap is a HARD stop enforced across all runs (ledger in scout.db).
# Default 20.0 leaves buffer under a $25 budget.
X_BEARER_TOKEN=
XAPI_SPEND_CAP_USD=20.0

# --- GitHub discovery (optional; raises rate limits from ~10 to 30 req/min) --
# Free personal access token, no scopes needed: github.com/settings/tokens
GITHUB_TOKEN=

# --- Claude classification (optional — omit to run heuristics-only) --------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Phone digest (`scout publish --push`) ---------------------------------
# A PUBLIC repo that serves the rendered digest via GitHub Pages. Separate
# from the code repo on purpose: only the rendered page goes public.
DIGEST_REPO=
