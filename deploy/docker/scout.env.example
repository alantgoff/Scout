# Scout self-host secrets — copy to ./scout.env at the repo root (it is
# gitignored and never enters the image), fill in, `docker compose up -d`.
# Read by every container at start; restart after editing:
#   docker compose up -d --force-recreate
# Non-secret shared knobs (spend cap, model, run sizes, Slack webhook) are
# edited in the app under Settings and stored in the database.

# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# SEC asks automated readers to identify themselves: "<firm> <contact email>".
SEC_USER_AGENT=

# --- Spend ------------------------------------------------------------------
# Total Claude + X spend per UTC day; paid calls stop when it is spent.
DAILY_SPEND_CAP_USD=1.0

# --- Sources (optional) -----------------------------------------------------
# Free GitHub token, no scopes — raises the search rate limit.
GITHUB_TOKEN=
# X via a burner account's cookies: copy the file into the volume first
#   docker compose cp x_cookies.json worker:/data/x_cookies.json
# then uncomment. Without it, runs source from the free channels only.
# TW_COOKIES=/data/x_cookies.json
# Paid X API (hard-capped by XAPI_SPEND_CAP_USD):
X_BEARER_TOKEN=
XAPI_SPEND_CAP_USD=20.0

# --- Sign-in ----------------------------------------------------------------
# Required whenever the workspace is reachable beyond this host (SCOUT_DOMAIN
# set, or SCOUT_BIND off loopback) — the UI refuses to start without it.
# Google Cloud Console → OAuth client (Web application), redirect URI
# https://<SCOUT_DOMAIN>/oauth2callback.
SCOUT_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Always-admin emails (comma-separated). Otherwise the first sign-in is admin.
SCOUT_ADMIN_EMAILS=
# Optional: generated on first start and kept in the volume if unset.
# SCOUT_COOKIE_SECRET=

# --- Backups (profile "backup") ---------------------------------------------
# Any S3-compatible bucket. For R2/B2/MinIO set the endpoint; for AWS leave
# it blank and set the region.
LITESTREAM_BUCKET=
LITESTREAM_REGION=auto
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
