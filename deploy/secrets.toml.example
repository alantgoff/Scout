# Streamlit native OIDC — copy to /opt/scout/.streamlit/secrets.toml (0600).
# Without this file Scout runs in single-user dev mode (identity "local@scout",
# overridable via SCOUT_DEV_USER) — fine on a laptop, never for the shared VM.

[auth]
redirect_uri = "https://scout.example.com/oauth2callback"
# 32+ random bytes; generate with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = ""
client_id = "<google-oauth-client-id>.apps.googleusercontent.com"
client_secret = "<google-oauth-client-secret>"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
