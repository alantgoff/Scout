# TLS + reverse proxy for the Scout workspace. Edit the domain, reload caddy.
# Stock Caddy (apt install caddy) — no plugins needed. Brute-force damping
# on sign-in isn't Caddy's job here: Google runs the login, and the
# /oauth2callback exchange is only valid with a code Google issued.
scout.example.com {
	reverse_proxy 127.0.0.1:8501
	# Streamlit uses a websocket (/_stcore/stream); reverse_proxy handles it.
}
