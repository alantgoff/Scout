# Secrets for a firm deployment — /etc/scout/scout.env, root:scout 0640.
# These are read by systemd (EnvironmentFile) for both the UI and the worker.
# They are NEVER editable from the app; the Settings page only shows presence.
# Non-secret shared knobs (spend cap, model, run sizes) are edited in the app.

ANTHROPIC_API_KEY=
# X scraping session (free path) — a burner account's cookies file:
TW_COOKIES=/etc/scout/x_cookies.json
# Paid X API (optional):
X_BEARER_TOKEN=
XAPI_SPEND_CAP_USD=25
# GitHub discovery rate limit boost (free PAT):
GITHUB_TOKEN=
# Comma-separated emails that are always admins:
SCOUT_ADMIN_EMAILS=

# --- CRM write-back (optional) ------------------------------------------------
# Startups at or past the push threshold (Settings page; Shortlisted by
# default) are written to your CRM: company matched by domain, list entry,
# a "Sourced by Scout" note, and the memo. Either or both.
# Attio: an API key with record, list-entry and note write scopes; the list
# (id or API slug) is optional.
ATTIO_API_KEY=
ATTIO_LIST=
# Affinity: Settings → API. The list must be an ORGANIZATION list (the
# number in its URL); optional.
AFFINITY_API_KEY=
AFFINITY_LIST_ID=
