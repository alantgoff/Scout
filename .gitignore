# Virtual env (recreate with `uv sync`)
.venv/

# Secrets & credentials — never commit
.env
cookies.json
*.cookies

# Local data: budget ledger / cache lives at ~/.scout/scout.db, but a legacy
# or DB_PATH-overridden copy may land here
scout.db
*.db
# EXCEPT the headless-runner store: GitHub Actions accumulates startups in
# data/scout.db and commits it back after every run (see .github/workflows).
!data/scout.db

# Run artifacts
out/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# macOS
.DS_Store

# Phone digest checkout (its own repo: scout-digest)
docs/
